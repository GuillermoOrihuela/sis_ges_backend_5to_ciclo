# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el .env real al repositorio.

# Django
SECRET_KEY=cambia-esta-clave-por-una-segura
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (formato django-environ db URL)
# SQLite (por defecto si se omite):
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL:
# DATABASE_URL=postgres://usuario:password@localhost:5432/manicure_db

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
